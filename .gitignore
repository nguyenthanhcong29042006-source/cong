# ===== BÍ MẬT — TUYỆT ĐỐI KHÔNG ĐẨY LÊN GITHUB =====
.streamlit/secrets.toml
data/users.json          # tài khoản sẽ tự tạo lại khi app khởi động

# ===== Sinh lại được, không cần đưa lên =====
data/cache/audio/        # file mp3, gTTS tạo lại trong 1-2 giây
data/cache/models.json   # danh sách model, tự dò lại
__pycache__/
*.pyc
.venv/
venv/
*.pdf.bak
_backup/

